# Database Credentials (Optional PostgreSQL, automatically falls back to local SQLite if unconfigured)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=quantiphi_db

# Microservice Ports
GATEWAY_PORT=5000
USER_SERVICE_PORT=5001
PROJECT_SERVICE_PORT=5002
TASK_SERVICE_PORT=5003

# Service URLs for API Gateway
USER_SERVICE_URL=http://localhost:5001
PROJECT_SERVICE_URL=http://localhost:5002
TASK_SERVICE_URL=http://localhost:5003
